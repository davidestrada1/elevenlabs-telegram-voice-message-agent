{
  "name": "elevenlabs-telegram-voice-message-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interview-ready Telegram text-and-voice-message agent powered primarily by ElevenLabs.",
  "scripts": {
