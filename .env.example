# Copy to .env locally or set these names in your hosting secret manager.
# Never commit .env, paste a key into chat, or expose a key to a Telegram client.

PORT=3000
LOG_LEVEL=info

# Telegram bot created through BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-public-host.example/webhooks/telegram
TELEGRAM_ACCOUNT_ID=interview-demo

# ElevenLabs service-account API key and dashboard configuration.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# Product controls.
TELEGRAM_REPLY_WITH_VOICE=true
AUDIO_REPLY_MODE=always
MAX_INBOUND_AUDIO_BYTES=20971520
MAX_REPLY_CHARS=1400
HIGH_VOLUME_MODE=false
HIGH_VOLUME_ESTIMATED_WAIT_SECONDS=120
CHAT_MODE_RESPONSE_TIMEOUT_MS=30000
